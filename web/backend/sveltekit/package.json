		"prisma": "^7.10.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@node-rs/argon2": "^2.2.1",
		"@prisma/adapter-pg": "^7.10.0",
