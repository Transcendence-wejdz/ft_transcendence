generator client {
  provider = "prisma-client"
  output   = "../src/lib/server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  displayName  String    @unique @map("display_name")
  color        String    @default("Black")
  class        String    @default("Warrior")
  avatarUrl    String?   @map("avatar_url")
  gameSettings Json?     @map("game_settings")
  gold         Int       @default(0)
  upgrades     Json      @default("{}")
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  sessions     Session[]
  gameRuns     GameRun[]
  sentFriendships     Friendship[] @relation("FriendshipSender")
  receivedFriendships Friendship[] @relation("FriendshipReceiver")

  @@map("users")
}

model Session {
  id        String   @id
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "sessions_user_id_idx")
  @@map("sessions")
}

model GameRun {
  id         String    @id @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  mode       String
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)
  runId      Int?      @map("run_id")
  score      Int?
  wave       Int?
  seconds    Int?
  kills      Int?
  victory    Boolean?
  gold       Int?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt], map: "game_runs_user_id_started_at_idx")
  @@map("game_runs")
}
enum Status {
  PENDING
  ACCEPTED
  BLOCKED
}

model Friendship {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  senderId   String  @map("sender_id") @db.Uuid
  sender   User   @relation("FriendshipSender", fields: [senderId], references: [id])
  receiverId String  @map("receiver_id") @db.Uuid
  receiver   User   @relation("FriendshipReceiver", fields: [receiverId], references: [id])
  relationStatus Status @default(PENDING)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("friendship")
  @@unique([senderId, receiverId])
}
